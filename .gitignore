# Environnement virtuel
env/

# Secrets
.env

# Caches Python et tests
__pycache__/
*.pyc
.pytest_cache/

# Bases de données (générées au lancement)
database/*.db
*.db

# Fichiers déposés par les utilisateurs
uploads/*
!uploads/.gitkeep

# Audio généré par l'API (Sprint 4)
api_service/temp_audio/*
!api_service/temp_audio/.gitkeep

# Logs
logs/

# Sorties de l'audit des logs (régénérées par data_pipeline/logs_parser.py)
data/processed/upload_events.csv
data/reports/

# Dataset NLP (Sprint 3) : régénéré par python -m ai_engine.prepare_dataset
# (seul stats.json est versionné : les données font plusieurs Mo)
ai_engine/data/*.jsonl

# Éditeurs
.vscode/
.claude/
# Notes de travail (le document final sera livré en PDF)
docs/