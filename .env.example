# Copier ce fichier en .env puis remplir les valeurs
SECRET_KEY=change-moi

# Assistant DRH (Sprint 3) et reformulation du pitch (Sprint 4)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# API FastAPI /speak-smart (Sprint 4)
